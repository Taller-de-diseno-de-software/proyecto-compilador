int limite;

int maximo(int a, int b) {
    if (a > b) { return a; }
    return b;
}

void main() {
    int i;
    int acc;
    boolean ok;
    limite = 3;
    i = 0;
    acc = 1;
    while (i < limite && acc < 100) {
        acc = maximo(acc * 2, i + 1);
        i = i + 1;
    }
    ok = acc > 5 || !(i == 0);
}
